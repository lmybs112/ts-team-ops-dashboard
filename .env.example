# Preview / local API bearer tokens — PLACEHOLDERS ONLY (never commit real values).
# Aligns with docs/security/2026-09-21-r2-public-write-preview-runbook.md §2
# Generate: openssl rand -hex 32   (≥128 bit). One actor → one secret. No god keys.

TOKEN_MEI=
TOKEN_CTO=
TOKEN_FRONTEND=
TOKEN_BACKEND=
TOKEN_PM=
TOKEN_UIUX=
TOKEN_QA=
TOKEN_DEVOPS=

# Optional dual-slot rotation (≤1h window). Leave empty if unused.
# TOKEN_MEI_PREVIOUS=
# TOKEN_CTO_PREVIOUS=
# TOKEN_FRONTEND_PREVIOUS=
# TOKEN_BACKEND_PREVIOUS=
# TOKEN_PM_PREVIOUS=
# TOKEN_UIUX_PREVIOUS=
# TOKEN_QA_PREVIOUS=
# TOKEN_DEVOPS_PREVIOUS=

# Forbidden examples (do not add):
# TOKEN_GOD / TOKEN_ALL / SHARED_BOT_TOKEN / PREVIEW_PASSWORD=preview
# TEST_TOKENS from unit tests (test-token-*) must NEVER be used in public preview.
